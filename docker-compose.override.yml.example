# Local override — gitignored, so it survives `update.sh`.
#
# Gives php-fpm read-only visibility of the config files that live in other containers,
# so the Spam Manager page can show a live "local customizations intact?" check.
# Directories (not single files) are mounted: a single-file bind mount goes stale when
# an update replaces the file with a new inode, a directory mount does not.
services:
  php-fpm-mailcow:
    volumes:
      - ./data/conf/rspamd/local.d:/localcheck/rspamd-local.d:ro,z
      - ./data/conf/rspamd/meta_exporter:/localcheck/rspamd-meta_exporter:ro,z
      - ./data/conf/postfix:/localcheck/postfix:ro,z
      - ./data/conf/clamav:/localcheck/clamav:ro,z
      - ./data/updater:/updater:z
