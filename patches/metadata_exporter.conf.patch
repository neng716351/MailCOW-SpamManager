diff --git a/data/conf/rspamd/local.d/metadata_exporter.conf b/data/conf/rspamd/local.d/metadata_exporter.conf
index cc85faac..cdc00002 100644
--- a/data/conf/rspamd/local.d/metadata_exporter.conf
+++ b/data/conf/rspamd/local.d/metadata_exporter.conf
@@ -17,6 +17,18 @@ rules {
     selector = "mailcow_rcpt";
     formatter = "multipart";
   }
+  OUTBOUND_HOLD {
+    backend = "http";
+    url = "http://nginx:9081/pipe_outbound.php";
+    selector = "outbound_reject";
+    formatter = "multipart";
+  }
+  INBOUND_NOTIFY {
+    backend = "http";
+    url = "http://nginx:9081/pipe_inbound_notify.php";
+    selector = "inbound_reject";
+    formatter = "multipart";
+  }
 }
 
 custom_select {
@@ -43,17 +55,40 @@ return function(task)
 end
 EOD;
   reject_no_global_bl = <<EOD
+-- Local change 2026-10-28: widened so ALL reject / add header / rewrite subject
+-- mail (including global-blacklist and impersonation hits) is kept in quarantine,
+-- so admins can review and release it from the Spam Manager page. Mail is still
+-- rejected; this only keeps a copy. Original guard preserved in local-fixes backup.
+return function(task)
+  local action = task:get_metric_action('default')
+  if action == 'reject' or action == 'add header' or action == 'rewrite subject' then
+    return true
+  end
+  return false
+end
+EOD;
+  outbound_reject = <<EOD
+-- Local addition 2026-10-28: hold OUTBOUND (authenticated local sender) mail that was
+-- rejected, so an admin can review and release it to the external recipient. The
+-- endpoint keeps only external recipients. Mail is still rejected; this only keeps a copy.
 return function(task)
-  if not task:has_symbol('GLOBAL_SMTP_FROM_BL')
-    and not task:has_symbol('GLOBAL_MIME_FROM_BL')
-    and not task:has_symbol('LOCAL_BL_ASN')
-    and not task:has_symbol('GLOBAL_RCPT_BL')
-    and not task:has_symbol('BAD_SUBJECT_00')
-    and not task:has_symbol('MAILCOW_BLACK') then
-      local action = task:get_metric_action('default')
-      if action == 'reject' or action == 'add header' or action == 'rewrite subject' then
-        return true
-      end
+  local action = task:get_metric_action('default')
+  if action ~= 'reject' then return false end
+  if task:has_symbol('MAILCOW_AUTH') then
+    return true
+  end
+  return false
+end
+EOD;
+  inbound_reject = <<EOD
+-- Local addition: notify the admin when mail addressed to a local mailbox is rejected.
+-- Excludes our own authenticated senders (those go through OUTBOUND_HOLD instead).
+return function(task)
+  local action = task:get_metric_action('default')
+  if action ~= 'reject' then return false end
+  if task:has_symbol('MAILCOW_AUTH') then return false end
+  if task:has_symbol('RCPT_MAILCOW_DOMAIN') then
+    return true
   end
   return false
 end
